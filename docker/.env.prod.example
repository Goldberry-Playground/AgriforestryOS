# Server-stack config for docker-compose.prod.yml.
# At deploy time the GitHub Actions workflow writes the real values here
# (from 1Password → GitHub secrets). This .example documents the keys; the
# real /opt/agriforestryos/.env is NEVER committed (chmod 600, owned by deploy).

# --- farmOS operational database (the `db` service) ---
FARMOS_DB_USER=farm
FARMOS_DB_PASSWORD=changeme
FARMOS_DB_NAME=farm

# --- farmOS admin (used by the sync + ETL services over JSON:API) ---
FARMOS_USERNAME=admin
FARMOS_PASSWORD=changeme

# --- PostGIS spatial mirror (the `postgis` service) ---
POSTGIS_USER=farm
POSTGIS_PASSWORD=changeme
POSTGIS_DB=agriforestryos

# --- Odoo (sync service) ---
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=goldberry
ODOO_USER=sync@goldberrygrove.farm
ODOO_PASSWORD=changeme
ODOO_ORCHARD_LOCATION=Orchard
NURSERY_STOCK_CATEGORIES=Plants / Nursery Stock

# --- Poll cadences ---
POLL_INTERVAL_SECONDS=900
ETL_INTERVAL_SECONDS=900
HARVEST_POLL_SECONDS=900
