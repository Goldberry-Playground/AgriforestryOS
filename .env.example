# farmOS Database (used by docker/docker-compose.development.yml)
# Default dev values: user=farm, password=farm, db=farm

# Odoo ERP (Sprint 4 — sync service)
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=goldberry
ODOO_USER=sync@goldberrygrove.farm
ODOO_PASSWORD=changeme

# Odoo → farmOS sync service (Sprint 4)
# farmOS target uses basic auth (same creds as the MCP server / GeoJSON export).
FARMOS_BASE_URL=http://localhost
FARMOS_USERNAME=admin
FARMOS_PASSWORD=changeme
# Orchard stock location: resolved by name, or set the id explicitly to skip lookup.
ODOO_ORCHARD_LOCATION=Orchard
# ODOO_ORCHARD_LOCATION_ID=117
# Odoo product categories that mean "nursery stock for sale" (comma-separated).
NURSERY_STOCK_CATEGORIES=Plants / Nursery Stock
# Poll cadence and cursor file.
POLL_INTERVAL_SECONDS=900
SYNC_STATE_FILE=/data/sync_state.json

# PostGIS (Sprint 5 — spatial mirror)
POSTGIS_PASSWORD=changeme

# farmOS OAuth2 (Sprint 5 — MCP server + sync service)
FARMOS_CLIENT_ID=agriforestryos
FARMOS_CLIENT_SECRET=changeme
