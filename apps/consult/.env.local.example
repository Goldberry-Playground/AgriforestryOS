# Grove Consult (consult.gatheringatthegrove.com) — local dev env file.
# Copy to .env.local and fill in values. Do NOT commit .env.local.

# ── Odoo backend (BFF only — the browser never sees these) ───────────────
ODOO_URL=http://localhost:8069
# The nursery headless key (spec §C.7).
ODOO_API_KEY=

# ── Cloudflare Access (production/consult.tf sets both) ──────────────────
# Every request except GET /healthz must carry a valid Cf-Access-Jwt-Assertion.
# With CF_ACCESS_AUD unset the app denies everything (fail closed).
CF_ACCESS_TEAM_DOMAIN=goldberrygrove
CF_ACCESS_AUD=

# Local dev only: skip the Access check. Ignored when NODE_ENV=production.
CONSULT_AUTH_BYPASS=1
